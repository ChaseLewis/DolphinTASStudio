+// Optional ABI 3 extension. SIZE_MAX means the boot observation overflowed.
+DOLPHIN_TAS_EXPORT size_t dolphin_tas_copy_boot_polls(Core::Tas::Poll* output, size_t capacity)
+{
+  if (Core::Tas::boot_poll_overflow) return SIZE_MAX;
+  const auto& polls = Core::Tas::boot_polls;
+  if (output && capacity >= polls.size()) std::copy(polls.begin(), polls.end(), output);
+  return polls.size();
+}
