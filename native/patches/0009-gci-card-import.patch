+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "Common/FileUtil.h"
+#include "Core/HW/GCMemcard/GCMemcardUtils.h"
+
+#ifdef _WIN32
+#define TAS_CARD_EXPORT __declspec(dllexport)
+#else
+#define TAS_CARD_EXPORT __attribute__((visibility("default")))
+#endif
+
+// Builds a new raw card using the same importer as Dolphin's memory card manager.
+// The caller supplies a disposable destination; source saves are only read.
+extern "C" TAS_CARD_EXPORT bool dolphin_tas_create_memory_card(
+    const char* const* paths, size_t count, const char* destination, bool japanese,
+    char* error, size_t error_capacity)
+{
+  try
+  {
+    if (!paths || count == 0 || count > 127 || !destination || File::Exists(destination))
+      throw std::runtime_error("Choose 1-127 GCI saves and an unused output file.");
+    std::vector<Memcard::Savefile> saves;
+    size_t blocks = 0;
+    for (size_t i = 0; i < count; ++i)
+    {
+      if (!paths[i] || File::GetSize(paths[i]) > 16 * 1024 * 1024)
+        throw std::runtime_error("GCI save is missing or too large.");
+      auto result = Memcard::ReadSavefile(paths[i]);
+      auto* save = std::get_if<Memcard::Savefile>(&result);
+      if (!save || save->blocks.empty())
+        throw std::runtime_error(std::string("Invalid GCI save: ") + paths[i]);
+      blocks += save->blocks.size();
+      if (blocks > 2043)
+        throw std::runtime_error("The saves exceed a 2043-block GameCube memory card.");
+      saves.emplace_back(std::move(*save));
+    }
+    if (Memcard::HasDuplicateIdentity(saves))
+      throw std::runtime_error("The folder contains multiple copies of the same in-game save. Choose a folder with one copy of each save.");
+    u16 size_mbits = 4;
+    while (size_mbits * 16 - 5 < blocks)
+      size_mbits *= 2;
+    auto card = Memcard::GCMemcard::Create(destination, CardFlashId{}, size_mbits, japanese, 0,
+                                          japanese ? 0 : 1, 0);
+    if (!card)
+      throw std::runtime_error("Could not create the imported memory card.");
+    for (const auto& save : saves)
+    {
+      if (card->ImportFile(save) != Memcard::GCMemcardImportFileRetVal::SUCCESS)
+        throw std::runtime_error("Dolphin could not import a save into the memory card.");
+    }
+    if (!card->FixChecksums() || !card->Save())
+      throw std::runtime_error("Could not save the imported memory card.");
+    return true;
+  }
+  catch (const std::exception& exception)
+  {
+    if (error && error_capacity)
+    {
+      const size_t length = std::min(error_capacity - 1, std::strlen(exception.what()));
+      std::memcpy(error, exception.what(), length);
+      error[length] = '\0';
+    }
+    return false;
+  }
+  catch (...)
+  {
+    return false;
+  }
+}
