+  for (auto& mixer : m_wiimote_speaker_mixers)
+    mixer.ClearOutput();
+  m_skylander_portal_mixer.ClearOutput();
+  for (auto& mixer : m_gba_mixers)
+    mixer.ClearOutput();
+}
+
+void Mixer::MixerFifo::ClearOutput()
+{
+  m_next_buffer = {};
+  m_next_buffer_index = 0;
+  m_current_index = 0;
+  m_front = {};
+  m_back = {};
+  m_queue_head.store(0);
+  m_queue_tail.store(0);
+  m_queue_fading.store(false);
+  m_queue_looping.store(false);
+  m_fade_volume = 0;
+  m_quantization_error = {};
+}
