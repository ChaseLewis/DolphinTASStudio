+// Copyright 2026 Dolphin TAS Studio contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+#include "InputCommon/GCPadStatus.h"
+
+// Accessed only by the frontend's emulation owner thread in single-core mode.
+// Input snapshots are deliberately not restored: every step supplies its inputs.
+namespace Core::Tas
+{
+inline constexpr unsigned ABI_VERSION = 3;
+inline constexpr unsigned PORT_COUNT = 4;
+inline constexpr u16 BUTTON_MASK = PAD_BUTTON_LEFT | PAD_BUTTON_RIGHT | PAD_BUTTON_DOWN |
+    PAD_BUTTON_UP | PAD_TRIGGER_Z | PAD_TRIGGER_R | PAD_TRIGGER_L | PAD_BUTTON_A |
+    PAD_BUTTON_B | PAD_BUTTON_X | PAD_BUTTON_Y | PAD_BUTTON_START;
+inline std::array<GCPadStatus, PORT_COUNT> pads{};
+inline std::array<bool, PORT_COUNT> pad_enabled{};
+// Cumulative diagnostic observations, not canonical emulation state.
+inline std::array<u64, PORT_COUNT> pad_poll_counts{};
+inline std::array<GCPadStatus, PORT_COUNT> last_polled_pads{};
+inline u64 field_count = 0;
+// Host-lifetime observation, deliberately not restored with savestates.
+inline u64 presentation_count = 0;
+struct Poll
+{
+  u64 ticks, fields;
+  u32 port;
+  u16 buttons;
+  u8 stick_x, stick_y, cstick_x, cstick_y, trigger_l, trigger_r;
+};
+static_assert(sizeof(Poll) == 32);
+inline std::vector<Poll> polls, replay_polls;
+inline u64 poll_start_ticks = 0, poll_start_fields = 0;
+inline size_t replay_cursor = 0;
+inline bool collect_polls = false, replaying_polls = false, poll_mismatch = false;
+inline constexpr size_t MAX_POLLS = 100000;
+}  // namespace Core::Tas
