+};
+static_assert(sizeof(DolphinTasPad) == 8);
+
+DOLPHIN_TAS_EXPORT uint32_t dolphin_tas_get_abi_version()
+{
+  return Core::Tas::ABI_VERSION;
+}
+
+// All TAS exports must be called at boundaries, on the retro_run owner thread.
+// Null disables the override for this port. No normalization or trigger coupling.
+DOLPHIN_TAS_EXPORT bool dolphin_tas_set_pad(unsigned port, const DolphinTasPad* input)
+{
+  if (port >= Core::Tas::PORT_COUNT || Core::System::GetInstance().IsDualCoreMode())
+    return false;
+  if (!input)
+  {
+    Core::Tas::pad_enabled[port] = false;
+    return true;
+  }
+  if ((input->buttons & ~Core::Tas::BUTTON_MASK) != 0)
+    return false;
+  GCPadStatus pad;
+  pad.button = input->buttons;
+  pad.stickX = input->stick_x;
+  pad.stickY = input->stick_y;
+  pad.substickX = input->cstick_x;
+  pad.substickY = input->cstick_y;
+  pad.triggerLeft = input->trigger_l;
+  pad.triggerRight = input->trigger_r;
+  pad.analogA = (pad.button & PAD_BUTTON_A) ? UINT8_MAX : 0;
+  pad.analogB = (pad.button & PAD_BUTTON_B) ? UINT8_MAX : 0;
+  Core::Tas::pads[port] = pad;
+  Core::Tas::pad_enabled[port] = true;
+  return true;
+}
+
+DOLPHIN_TAS_EXPORT uint64_t dolphin_tas_get_ticks()
+{
+  return Core::System::GetInstance().GetCoreTiming().GetTicks();
+}
+
+DOLPHIN_TAS_EXPORT uint64_t dolphin_tas_get_field_count()
+{
+  return Core::Tas::field_count;
+}
+
+DOLPHIN_TAS_EXPORT uint64_t dolphin_tas_get_presentation_count()
+{
+  return Core::Tas::presentation_count;
+}
+
+DOLPHIN_TAS_EXPORT bool dolphin_tas_begin_polls(const Core::Tas::Poll* polls, size_t count, bool replay)
+{
+  namespace Tas = Core::Tas;
+  if (count > Tas::MAX_POLLS || (count && !polls)) return false;
+  Tas::polls.clear(); Tas::replay_polls.clear();
+  if (count) Tas::replay_polls.assign(polls, polls + count);
+  Tas::replay_cursor = 0; Tas::poll_mismatch = false;
+  Tas::poll_start_ticks = Core::System::GetInstance().GetCoreTiming().GetTicks();
+  Tas::poll_start_fields = Tas::field_count;
+  Tas::collect_polls = true; Tas::replaying_polls = replay;
+  return true;
+}
+
+DOLPHIN_TAS_EXPORT bool dolphin_tas_end_polls()
+{
+  namespace Tas = Core::Tas;
+  Tas::collect_polls = false;
+  return !Tas::poll_mismatch && (!Tas::replaying_polls || Tas::replay_cursor == Tas::replay_polls.size());
+}
+
+DOLPHIN_TAS_EXPORT size_t dolphin_tas_copy_polls(Core::Tas::Poll* output, size_t capacity)
+{
+  const auto& polls = Core::Tas::polls;
+  if (output && capacity >= polls.size()) std::copy(polls.begin(), polls.end(), output);
+  return polls.size();
+}
+
+DOLPHIN_TAS_EXPORT uint64_t dolphin_tas_get_pad_poll_count(unsigned port)
+{
+  return port < Core::Tas::PORT_COUNT ? Core::Tas::pad_poll_counts[port] : 0;
+}
+
+DOLPHIN_TAS_EXPORT bool dolphin_tas_get_last_polled_pad(unsigned port, DolphinTasPad* output)
+{
+  if (port >= Core::Tas::PORT_COUNT || !output || !Core::Tas::pad_poll_counts[port])
+    return false;
+  const auto& pad = Core::Tas::last_polled_pads[port];
+  *output = {pad.button, pad.stickX, pad.stickY, pad.substickX, pad.substickY,
+             pad.triggerLeft, pad.triggerRight};
+  return true;
+}
