diff --git a/Source/Core/Core/TasTrace.h b/Source/Core/Core/TasTrace.h
new file mode 100644
index 0000000..81e8ec9
--- /dev/null
+++ b/Source/Core/Core/TasTrace.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <array>
+#include <thread>
+
+#include "Core/Config/MainSettings.h"
+#include "Core/Core.h"
+#include "Core/CoreTiming.h"
+#include "Core/HW/CPU.h"
+#include "Core/PowerPC/JitInterface.h"
+#include "Core/PowerPC/PowerPC.h"
+#include "Core/System.h"
+#include "Core/Tas.h"
+#include "Core/TasTraceBuffer.h"
+
+namespace Core::TasTrace
+{
+inline Buffer buffer;
+inline std::array<uint32_t, 64> points{};
+inline size_t point_count = 0;
+inline bool active = false, previous_debugging = false, previous_breaking = true;
+inline uint32_t stop_reason = 0;
+inline std::thread::id owner;
+
+inline bool IsBoundary()
+{
+  auto& system = Core::System::GetInstance();
+  return owner == std::this_thread::get_id() && !system.IsDualCoreMode() &&
+         system.GetCPU().IsStepping();
+}
+
+inline void Stop(uint32_t reason)
+{
+  if (!active)
+    return;
+  auto& system = Core::System::GetInstance();
+  const Core::CPUThreadGuard guard(system);
+  active = false;
+  stop_reason = reason;
+  auto& breakpoints = system.GetPowerPC().GetBreakPoints();
+  for (size_t index = 0; index < point_count; ++index)
+    breakpoints.Remove(points[index]);
+  point_count = 0;
+  breakpoints.EnableBreaking(previous_breaking);
+  Config::SetCurrent(Config::MAIN_ENABLE_DEBUGGING, previous_debugging);
+  system.GetJitInterface().ClearCache(guard);
+}
+
+inline bool Start(const uint32_t* addresses, size_t count, size_t capacity)
+{
+  if (!IsBoundary() || active || !addresses || !count || count > points.size() ||
+      !capacity || capacity > 1048576 || buffer.Drain(nullptr, 0))
+    return false;
+  auto& system = Core::System::GetInstance();
+  const Core::CPUThreadGuard guard(system);
+  auto& breakpoints = system.GetPowerPC().GetBreakPoints();
+  for (size_t index = 0; index < count; ++index)
+  {
+    if (addresses[index] < 0x80000000 || addresses[index] >= 0x81800000 ||
+        (addresses[index] & 3) || breakpoints.IsAddressBreakPoint(addresses[index]))
+      return false;
+    for (size_t earlier = 0; earlier < index; ++earlier)
+      if (addresses[index] == addresses[earlier])
+        return false;
+  }
+  buffer.Reset(capacity);
+  previous_debugging = Config::Get(Config::MAIN_ENABLE_DEBUGGING);
+  previous_breaking = breakpoints.IsBreakingEnabled();
+  stop_reason = 0;
+  active = true;
+  for (size_t index = 0; index < count; ++index)
+  {
+    breakpoints.Add(addresses[index], false, false, std::nullopt);
+    points[point_count++] = addresses[index];
+  }
+  breakpoints.EnableBreaking(true);
+  Config::SetCurrent(Config::MAIN_ENABLE_DEBUGGING, true);
+  system.GetJitInterface().ClearCache(guard);
+  return true;
+}
+
+inline bool IsPoint(uint32_t address)
+{
+  return active && std::find(points.begin(), points.begin() + point_count, address) !=
+                       points.begin() + point_count;
+}
+
+inline void Observe(Core::System& system, const PowerPC::PowerPCState& state)
+{
+  if (!IsPoint(state.pc))
+    return;
+  Record record{};
+  record.ticks = system.GetCoreTiming().GetTicks();
+  record.fields = Core::Tas::field_count;
+  record.pc = state.pc;
+  record.lr = state.spr[SPR_LR];
+  std::copy(std::begin(state.gpr), std::end(state.gpr), record.gpr);
+  buffer.Push(record);
+}
+
+inline void ObserveCurrent(Core::System& system)
+{
+  Observe(system, system.GetPPCState());
+}
+}
diff --git a/Source/Core/Core/TasTraceBuffer.h b/Source/Core/Core/TasTraceBuffer.h
new file mode 100644
index 0000000..1908378
--- /dev/null
+++ b/Source/Core/Core/TasTraceBuffer.h
@@ -0,0 +1,72 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace Core::TasTrace
+{
+struct Record
+{
+  uint64_t sequence, ticks, fields;
+  uint32_t pc, lr;
+  uint32_t gpr[32];
+};
+static_assert(sizeof(Record) == 160);
+
+struct Status
+{
+  uint32_t version, record_size, active, stop_reason;
+  uint64_t capacity, pending, observed, dropped;
+};
+static_assert(sizeof(Status) == 48);
+
+class Buffer
+{
+public:
+  void Reset(size_t capacity)
+  {
+    std::vector<Record> replacement(capacity);
+    m_records.swap(replacement);
+    m_head = m_count = 0;
+    m_observed = m_dropped = 0;
+  }
+
+  void Push(Record record)
+  {
+    record.sequence = m_observed++;
+    if (m_count == m_records.size())
+    {
+      ++m_dropped;
+      return;
+    }
+    m_records[(m_head + m_count) % m_records.size()] = record;
+    ++m_count;
+  }
+
+  size_t Drain(Record* output, size_t capacity)
+  {
+    if (!output)
+      return m_count;
+    const size_t count = std::min(capacity, m_count);
+    for (size_t index = 0; index < count; ++index)
+      output[index] = m_records[(m_head + index) % m_records.size()];
+    if (!m_records.empty())
+      m_head = (m_head + count) % m_records.size();
+    m_count -= count;
+    return count;
+  }
+
+  Status GetStatus(bool active, uint32_t reason) const
+  {
+    return {1, sizeof(Record), active ? 1u : 0u, reason, m_records.size(), m_count,
+            m_observed, m_dropped};
+  }
+
+private:
+  std::vector<Record> m_records;
+  size_t m_head = 0, m_count = 0;
+  uint64_t m_observed = 0, m_dropped = 0;
+};
+}
